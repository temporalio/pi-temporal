{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // The checks too, since they build the same protocol shapes as the workers.
  "include": ["src/**/*.ts", "extensions/**/*.ts", "checks/**/*.mts", "scripts/**/*.mts"]
}
