# Pins a build of the temporalio/pi fork. The step-level API this executor needs (`prepareStep`,
# `recordPrompt`, `modelCall`/`runToolCall`/`sealStep`, `setWriteGuard`, `registerTurnExecutor`)
# isn't in the published @earendil-works/pi-coding-agent.
# To bump it, set PI_FORK_REF to the new fork commit, then re-run scripts/setup-fork.sh.

PI_FORK_REPO=https://github.com/temporalio/pi.git
PI_FORK_REF=07b4ed4ae29c7b5b717a0cf34049b5b197645c16
