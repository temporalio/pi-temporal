# The Pi build this executor depends on.
#
# temporalio/pi PR #2 (branch moe/step-and-resume) adds the four calls a stepped driver needs:
# recordPrompt, prepareStep, step, and resumeInterruptedTurn on AgentSession. None of them is in
# the published @earendil-works/pi-coding-agent, so the dependency is a build of the fork.
#
# Bump PI_FORK_REF when the PR moves, then re-run scripts/setup-fork.sh.

PI_FORK_REPO=https://github.com/temporalio/pi.git
PI_FORK_REF=989c52f34fac4db7f1facc0d50774346130abe86
