# The Pi build this executor depends on.
#
# temporalio/pi PR #2 (branch moe/step-and-resume) adds AgentSession.resumeInterruptedTurn()
# and AgentSession.step(). Neither is in the published @earendil-works/pi-coding-agent, and
# mid-turn recovery here calls the first one, so the dependency is a build of the fork.
#
# Bump PI_FORK_REF when the PR moves, then re-run scripts/setup-fork.sh and npm install.

PI_FORK_REPO=https://github.com/temporalio/pi.git
PI_FORK_REF=442ea6aefb5b353772de6bc225b920b9b6107121
