{
  "name": "pi-temporal",
  "version": "0.0.0",
  "private": true,
  "description": "Temporal-backed durable executor for the Pi coding agent",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "setup-fork": "scripts/setup-fork.sh",
    "typecheck": "tsc --noEmit",
    "checks": "scripts/run-checks.sh",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
